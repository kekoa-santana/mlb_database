{
  "Comment": "Backfill Statcast + Boxscore day-by-day via mlb-deps-ecr",
  "StartAt": "BackfillPerDay",
  "States": {
    "BackfillPerDay": {
      "Type": "Map",
      "ItemsPath": "$.dates",
      "MaxConcurrency": 5,
      "ItemSelector": {
        "mode": "historical_raw",
        "start_date.$": "$$.Map.Item.Value",
        "end_date.$": "$$.Map.Item.Value"
      },
      "Iterator": {
        "StartAt": "InvokeBackfill",
        "States": {
          "InvokeBackfill": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "arn:aws:lambda:us-east-2:227271426748:function:mlb-deps-ecr",
              "Payload.$": "$",
              "InvocationType": "RequestResponse"
            },
            "ResultPath": null,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              },
              {
                "ErrorEquals": [
                  "ThrottlingException",
                  "TooManyRequestsException"
                ],
                "IntervalSeconds": 5,
                "MaxAttempts": 6,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": null,
                "Next": "SkipFailedDay"
              }
            ],
            "End": true
          },
          "SkipFailedDay": {
            "Type": "Pass",
            "End": true
          }
        }
      },
      "End": true
    }
  }
}
